+        button.setOnClickListener(view -> select());
+        button.setOnFocusChangeListener((view, focused) -> {
+            if (focused) refresh();
+        });
+    }
+
+    void refresh() {
+        if (checking || activating) return;
+        Context context = activity.getApplicationContext();
+        if (!StandbyCleanupReceiver.enabled(context)) {
+            show(StandbyCleanupStarter.Result.INACTIVE);
+            return;
+        }
+        checking = true;
+        int current = revision;
+        new Thread(() -> {
+            StandbyCleanupStarter.Result result = StandbyCleanupStarter.status(context);
+            activity.runOnUiThread(() -> {
+                checking = false;
+                if (!activity.isDestroyed() && current == revision) show(result);
+            });
+        }, "StandbyCleanupStatus").start();
+    }
+
+    private void select() {
+        if (activating) return;
+        if (state == StandbyCleanupStarter.Result.ACTIVE) {
+            new AlertDialog.Builder(activity)
+                    .setTitle(R.string.standby_cleanup_chip_title)
+                    .setMessage(R.string.standby_cleanup_started)
+                    .setPositiveButton(R.string.standby_cleanup_disable, (dialog, which) -> {
+                        revision++;
+                        StandbyCleanupReceiver.setEnabled(activity, false);
+                        show(StandbyCleanupStarter.Result.INACTIVE);
+                    })
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .show();
+            return;
+        }
+
+        revision++;
+        activating = true;
+        button.setContentDescription(activity.getString(R.string.standby_cleanup_starting));
+        StandbyCleanupStarter.reactivate(activity, result -> {
+            activating = false;
+            show(result);
+        });
+    }
+
+    private void show(StandbyCleanupStarter.Result result) {
+        state = result;
+        boolean active = result == StandbyCleanupStarter.Result.ACTIVE;
+        button.setCompoundDrawableTintList(activity.getColorStateList(
+                active ? R.color.standby_chip_on : R.color.standby_chip_off));
+        int description = switch (result) {
+            case ACTIVE -> R.string.standby_cleanup_started;
+            case INACTIVE -> R.string.standby_cleanup_chip_off;
+            default -> R.string.standby_cleanup_chip_unknown;
+        };
+        button.setContentDescription(activity.getString(description));
+    }
+}
