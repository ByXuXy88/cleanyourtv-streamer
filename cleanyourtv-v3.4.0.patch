+package com.gathin.tvhome;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+
+public final class StandbyCleanupReceiver extends BroadcastReceiver {
+    private static final String ENABLED = "enabled";
+    static final String COUNT = "closed_apps";
+    private static final String RAM_MB = "recovered_mb";
+
+    static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences("standby_cleanup", Context.MODE_PRIVATE);
+    }
+
+    static boolean enabled(Context context) {
+        return prefs(context).getBoolean(ENABLED, false);
+    }
+
+    static void setEnabled(Context context, boolean enabled) {
+        prefs(context).edit().putBoolean(ENABLED, enabled).remove(COUNT).remove(RAM_MB).apply();
+    }
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (!enabled(context)) return;
+        String action = intent.getAction();
+        if ("com.gathin.tvhome.standby.CHECK".equals(action)) {
+            if (isOrderedBroadcast()) setResultCode(1);
+        } else if ("com.gathin.tvhome.standby.RESULT".equals(action)) {
+            int count = intent.getIntExtra(COUNT, -1);
+            int ramMb = intent.getIntExtra(RAM_MB, -1);
+            if (count < 0 || ramMb < 0) return;
+            prefs(context).edit().putInt(COUNT, count).putInt(RAM_MB, ramMb).apply();
+        }
+    }
+
+    static String takePending(Context context) {
+        SharedPreferences prefs = prefs(context);
+        int count = prefs.getInt(COUNT, -1);
+        if (count < 0) return null;
+        int ramMb = prefs.getInt(RAM_MB, 0);
+        prefs.edit().remove(COUNT).remove(RAM_MB).apply();
+
+        if (count == 0) return context.getString(R.string.standby_cleanup_none);
+        String closed = context.getResources().getQuantityString(R.plurals.standby_cleanup_closed, count, count);
+        String ram = ramMb > 0 ? context.getString(R.string.standby_cleanup_ram, ramMb)
+                : context.getString(R.string.standby_cleanup_no_gain);
+        return closed + " - " + ram;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/StandbyCleanupStarter.java b/launcher/app/src/main/java/com/gathin/tvhome/StandbyCleanupStarter.java
new file mode 100644
index 0000000..6cee95f
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/StandbyCleanupStarter.java
@@ -0,0 +1,197 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.provider.Settings;
+import android.util.Base64;
+import android.util.Log;
+import android.widget.Toast;
+
+import org.bouncycastle.asn1.x500.X500Name;
+import org.bouncycastle.cert.jcajce.JcaX509CertificateConverter;
+import org.bouncycastle.cert.jcajce.JcaX509v3CertificateBuilder;
+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.security.KeyFactory;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.PrivateKey;
+import java.security.SecureRandom;
+import java.security.cert.Certificate;
+import java.security.cert.CertificateFactory;
+import java.security.spec.PKCS8EncodedKeySpec;
+import java.util.Date;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+
+import io.github.muntashirakon.adb.AdbConnection;
+import io.github.muntashirakon.adb.AdbStream;
+import io.github.muntashirakon.adb.android.AdbMdns;
+
+/** Starts the existing shell-owned helper through a short connection to this device only. */
+final class StandbyCleanupStarter {
+    enum Result { ACTIVE, INACTIVE, HELPER_UNAVAILABLE, CONNECTION_UNAVAILABLE }
+
+    private static final String TAG = "StandbyCleanupStarter";
+    private static final String HELPER = "/data/local/tmp/cleanyourtv-standby.sh";
+    private static final String MONITOR_RUNNING = "ps -A -o ARGS | grep -Fqx 'sh " + HELPER + "'";
+    private static final String STATUS = MONITOR_RUNNING + " && echo active || echo inactive";
+    private static final String START = "test -s " + HELPER + " || { echo missing; exit; }; "
+            + "if ! " + MONITOR_RUNNING + "; then toybox nohup setsid sh " + HELPER
+            + " </dev/null >/dev/null 2>&1 & sleep 1; fi; " + STATUS;
+
+    static Result status(Context context) {
+        return StandbyCleanupReceiver.enabled(context) ? request(context, false) : Result.INACTIVE;
+    }
+
+    static void reactivate(Activity activity, Consumer<Result> onResult) {
+        Context context = activity.getApplicationContext();
+        new Thread(() -> {
+            Result result = request(context, true);
+            if (result == Result.ACTIVE && !StandbyCleanupReceiver.enabled(context)) {
+                StandbyCleanupReceiver.setEnabled(context, true);
+            }
+            activity.runOnUiThread(() -> {
+                if (activity.isFinishing() || activity.isDestroyed()) return;
+                onResult.accept(result);
+                showActivationResult(activity, result);
+            });
+        }, "StandbyCleanupStarter").start();
+    }
+
+    private static void showActivationResult(Activity activity, Result result) {
+        if (result == Result.ACTIVE) {
+            Toast.makeText(activity, R.string.standby_cleanup_started, Toast.LENGTH_LONG).show();
+        } else if (result == Result.HELPER_UNAVAILABLE) {
+            new AlertDialog.Builder(activity).setMessage(R.string.standby_cleanup_helper_error)
+                    .setPositiveButton(android.R.string.ok, null).show();
+        } else {
+            new AlertDialog.Builder(activity).setMessage(R.string.standby_cleanup_connection_help)
+                    .setPositiveButton(R.string.standby_cleanup_debug, (dialog, which) -> {
+                        try {
+                            activity.startActivity(new Intent(Settings.ACTION_APPLICATION_DEVELOPMENT_SETTINGS));
+                        } catch (ActivityNotFoundException ignored) {
+                            activity.startActivity(new Intent(Settings.ACTION_SETTINGS));
+                        }
+                    })
+                    .setNegativeButton(android.R.string.cancel, null).show();
+        }
+    }
+
+    private static Result request(Context context, boolean activate) {
+        try {
+            boolean hasIdentity = identityPrefs(context).contains("private_key");
+            if (!activate) {
+                if (!hasIdentity) return Result.CONNECTION_UNAVAILABLE;
+                Result legacy = requestAt(context, 5555, 2, false);
+                if (legacy != Result.CONNECTION_UNAVAILABLE) return legacy;
+            }
+            if (hasIdentity) {
+                int tlsPort = findTlsPort(context);
+                if (tlsPort > 0) {
+                    Result secure = requestAt(context, tlsPort, activate ? 8 : 2, activate);
+                    if (secure != Result.CONNECTION_UNAVAILABLE) return secure;
+                }
+            }
+            return activate ? requestAt(context, 5555, 45, true) : Result.CONNECTION_UNAVAILABLE;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return Result.CONNECTION_UNAVAILABLE;
+        } catch (Exception e) {
+            Log.w(TAG, "Could not prepare local debugging", e);
+            return Result.CONNECTION_UNAVAILABLE;
+        }
+    }
+
+    private static Result requestAt(Context context, int port, int timeoutSeconds, boolean activate) throws Exception {
+        Identity identity = identity(context);
+        try (AdbConnection connection = new AdbConnection.Builder("127.0.0.1", port)
+                .setApi(Build.VERSION.SDK_INT)
+                .setDeviceName("CleanYourTV")
+                .setPrivateKey(identity.privateKey())
+                .setCertificate(identity.certificate())
+                .build()) {
+            if (!connection.connect(timeoutSeconds, TimeUnit.SECONDS, !activate)) {
+                return Result.CONNECTION_UNAVAILABLE;
+            }
+            try (AdbStream stream = connection.open("shell:" + (activate ? START : STATUS));
+                 BufferedReader output = new BufferedReader(new InputStreamReader(
+                         stream.openInputStream(), StandardCharsets.UTF_8))) {
+                String state = output.readLine();
+                if ("active".equals(state)) {
+                    if (activate) Log.i(TAG, "Cleanup active through local debugging on port " + port);
+                    return Result.ACTIVE;
+                }
+                if (activate) return Result.HELPER_UNAVAILABLE;
+                return "inactive".equals(state) ? Result.INACTIVE : Result.CONNECTION_UNAVAILABLE;
+            }
+        } catch (IOException e) {
+            if (activate) Log.i(TAG, "Local debugging connection on port " + port + " is unavailable", e);
+            return Result.CONNECTION_UNAVAILABLE;
+        }
+    }
+
+    private static int findTlsPort(Context context) throws InterruptedException {
+        CountDownLatch found = new CountDownLatch(1);
+        AtomicInteger port = new AtomicInteger();
+        AdbMdns discovery = new AdbMdns(context, AdbMdns.SERVICE_TYPE_TLS_CONNECT, (address, value) -> {
+            if (address != null && value > 0) {
+                port.set(value);
+                found.countDown();
+            }
+        });
+        discovery.start();
+        try {
+            return found.await(5, TimeUnit.SECONDS) ? port.get() : 0;
+        } finally {
+            discovery.stop();
+        }
+    }
+
+    private record Identity(PrivateKey privateKey, Certificate certificate) {}
+
+    private static SharedPreferences identityPrefs(Context context) {
+        return context.getSharedPreferences("standby_local_debug_identity", Context.MODE_PRIVATE);
+    }
+
+    private static synchronized Identity identity(Context context) throws Exception {
+        SharedPreferences keys = identityPrefs(context);
+        String key = keys.getString("private_key", null);
+        String cert = keys.getString("certificate", null);
+        if (key != null && cert != null) {
+            PrivateKey privateKey = KeyFactory.getInstance("RSA").generatePrivate(
+                    new PKCS8EncodedKeySpec(Base64.decode(key, Base64.NO_WRAP)));
+            Certificate certificate = CertificateFactory.getInstance("X.509").generateCertificate(
+                    new java.io.ByteArrayInputStream(Base64.decode(cert, Base64.NO_WRAP)));
+            return new Identity(privateKey, certificate);
+        }
+
+        KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        KeyPair pair = generator.generateKeyPair();
+        X500Name name = new X500Name("CN=CleanYourTV");
+        long now = System.currentTimeMillis();
+        Certificate certificate = new JcaX509CertificateConverter().getCertificate(
+                new JcaX509v3CertificateBuilder(name, new BigInteger(128, new SecureRandom()).setBit(127),
+                        new Date(now - TimeUnit.DAYS.toMillis(1)), new Date(now + TimeUnit.DAYS.toMillis(3650)),
+                        name, pair.getPublic()).build(
+                        new JcaContentSignerBuilder("SHA256withRSA").build(pair.getPrivate())));
+        if (!keys.edit().putString("private_key", Base64.encodeToString(pair.getPrivate().getEncoded(), Base64.NO_WRAP))
+                .putString("certificate", Base64.encodeToString(certificate.getEncoded(), Base64.NO_WRAP)).commit()) {
+            throw new IOException("Could not save the local debugging identity");
+        }
+        return new Identity(pair.getPrivate(), certificate);
+    }
+}
