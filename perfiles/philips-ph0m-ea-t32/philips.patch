+    /** Restore the configured helpers after Home or wake using only the already authorized local ADB key. */
+    static void restoreServices(Activity activity, Consumer<Boolean> onResult) {
+        restoreServices(activity.getApplicationContext(), false, ready -> activity.runOnUiThread(() -> {
+            if (!activity.isFinishing() && !activity.isDestroyed()) onResult.accept(ready);
+        }));
+    }
+
+    static void restoreServices(Context context, boolean openHomeAtBoot, Consumer<Boolean> onResult) {
+        if (!identityPrefs(context).contains("private_key") || !RESTORING.compareAndSet(false, true)) {
+            onResult.accept(false);
+            return;
+        }
+        new Thread(() -> {
+            boolean ready = false;
+            try {
+                for (int attempt = 0; attempt < 3 && !ready; attempt++) {
+                    if (attempt > 0) Thread.sleep(attempt * 2000L);
+                    ready = restoreLocal(context, openHomeAtBoot);
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                RESTORING.set(false);
+                onResult.accept(ready);
+            }
+        }, "PhilipsServiceRecovery").start();
+    }
+
+    private static boolean restoreLocal(Context context, boolean openHomeAtBoot) {
+        String recovery = RECOVER_SHIZUKU + (openHomeAtBoot ? " --home-if-live" : "");
+        String command = StandbyCleanupReceiver.enabled(context)
+                ? "( " + START + " ) >/dev/null 2>&1; " + recovery
+                : recovery;
+        try (AdbConnection connection = localConnection(context, 5555)) {
+            if (!connection.connect(2, TimeUnit.SECONDS, true)) return false;
+            try (AdbStream stream = connection.open("shell:" + command);
+                 BufferedReader output = new BufferedReader(new InputStreamReader(
+                         stream.openInputStream(), StandardCharsets.UTF_8))) {
+                return "ready".equals(output.readLine());
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        } catch (Exception e) {
+            Log.d(TAG, "Local service recovery unavailable", e);
+        }
+        return false;
     }
 
